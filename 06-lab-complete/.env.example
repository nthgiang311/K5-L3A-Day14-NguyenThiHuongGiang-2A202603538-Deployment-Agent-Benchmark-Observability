# Copy: cp .env.example .env   (.env đã nằm trong .gitignore — KHÔNG commit)
# Không ghi secret thật vào file này.

PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Bắt buộc: header X-API-Key phải trùng giá trị này (tạo bằng: openssl rand -hex 24)
AGENT_API_KEY=change-me

# Redis cho rate limit + cost guard (docker compose ghi đè thành redis://redis:6379/0)
REDIS_URL=redis://localhost:6379/0

# Số request tối đa / 60 giây cho mỗi API key
RATE_LIMIT_PER_MINUTE=10

# Ngân sách LLM (USD) — vượt → 402
DAILY_BUDGET_USD=1.0
MONTHLY_BUDGET_USD=10.0
